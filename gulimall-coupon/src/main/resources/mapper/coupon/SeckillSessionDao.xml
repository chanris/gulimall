<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.chanris.gulimall.coupon.dao.SeckillSessionDao">

    <resultMap type="com.chanris.gulimall.coupon.entity.SeckillSessionEntity" id="seckillSessionMap">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="getLatest3DaysSession" resultType="com.chanris.gulimall.coupon.dto.SeckillSessionDTO">
        select * from sms_seckill_session where start_time between   '2020-02-19 00:00:00' and  '2020-02-19 00:00:00'
    </select>

</mapper>